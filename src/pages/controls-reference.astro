---
import Layout from '../layouts/Layout.astro';
import "katex/dist/katex.min.css";
import katex from "katex";

const render = (tex: string) => katex.renderToString(tex, { displayMode: true, throwOnError: false });
---

<Layout title="Controls Reference — Brendan Rudberg">
  <main>
    <!-- ============ Summary ============ -->
    <section id="Summary">
      <h1>A CTSM Reference</h1>
      <p>
        I'm learning Continuous Time Stochastic Modeling (CTSM) for a research project.
        This relies on the Extended Kalman Filter (EKF) to work. In order to ensure I 
        fully understand it, I'm adding a section to my website breaking everything 
        down as simply as I can make it. This also serves as a reference for my future
        self. 
      </p>
    </section>
  </main>
</Layout>

<!-- ============ STYLES ============ -->
<style>
  * { box-sizing: border-box; }

  main { max-width: 780px; margin: 0 auto; padding: 3rem 2rem; }

  section { padding: 3rem 0; }
  h1 { font-size: 2.5rem; margin: 0 0 0.5rem; }
  h2 { font-size: 1.75rem; margin-top: 2rem; }
  h3 { margin-bottom: 0.5rem; }
  .tagline { color: #666; font-size: 1.1rem; }

  :global(.math-block .katex-display) {
    text-align: center;
    overflow-x: auto;
    overflow-y: hidden;
    padding: 4px 0;
  }
  :global(.math-block .katex-display > .katex) {
    display: inline-block;
    text-align: initial;
  }

  .project { margin-bottom: 3rem; }
  .project img {
    width: 100%;
    max-height: 540px;
    object-fit: cover;
    background: #f0f0f0;
    border-radius: 6px;
    margin: 0.5rem 0 1rem;
  }

  .project-figure img {
    width: 100%;        
    height: auto;
    max-height: 720px;  
    max-width: 100%;    
    object-fit: cover;
    background: #f0f0f0; 
    border-radius: 6px;
    margin: 0.5rem 0 1rem;
    object-position: center;
  }


  footer {
    text-align: center;
    padding: 2rem;
    color: #666;
    border-top: 1px solid #eee;
  }
  footer a { color: #666; }
</style>