---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Resume — Brendan Rudberg">
  <main class="resume-page">
    <h1>Resume</h1>
    <p><a href="/Brendan_Rudberg_Resume.pdf" download>Download PDF</a></p>
    <iframe
      src="/Brendan_Rudberg_Resume.pdf"
      title="Brendan Rudberg resume"
      width="100%"
      height="900px"
      style="border: none;"
    ></iframe>
  </main>
</Layout>

<style>
  .resume-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }
</style>